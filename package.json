{
  "name": "@bookklik/senangstart-css",
  "version": "0.4.0",
  "description": "Fluent Style Utilities for Humans and AI",
  "type": "module",
  "main": "./dist/senangstart-css.cjs",
  "module": "./dist/senangstart-css.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/senangstart-css.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/senangstart-css.cjs"
      },
      "default": "./dist/senangstart-css.cjs"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "import": "./src/node.js",
      "default": "./src/node.js"
    },
    "./cli": "./src/cli/program.js",
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./src/integrations/vite.js",
      "default": "./src/integrations/vite.js"
    },
    "./postcss": {
      "types": "./types/postcss.d.ts",
      "import": "./src/integrations/postcss.js",
      "default": "./src/integrations/postcss.js"
    },
    "./schema": "./schema/senangstart.config.schema.json",
    "./typed": {
      "types": "./types/typed.d.ts",
      "default": "./types/typed.js"
    },
    "./attributes": {
      "types": "./types/attributes.d.ts"
    },
    "./react": {
      "types": "./types/react.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts"
    },
    "./solid": {
      "types": "./types/solid.d.ts"
    },
    "./preact": {
      "types": "./types/preact.d.ts"
    },
    "./astro": {
      "types": "./types/astro.d.ts"
    },
    "./html-data": "./types/senang.html-data.json",
    "./data": "./types/senang-data.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/cli/**",
    "./src/cdn/**",
    "./dist/*.js"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "src",
    "types",
    "templates",
    "schema",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "senangstart": "./src/cli/index.js",
    "sen": "./src/cli/index.js"
  },
  "scripts": {
    "dev": "node src/cli/index.js dev",
    "build": "npm run build:dist && npm run docs:generate && vitepress build docs && npm run docs:llms",
    "build:dist": "node scripts/build-dist.js",
    "prepublishOnly": "npm run lint && npm test && npm run golden && npm run build:dist && npm run size",
    "generate:types": "node scripts/generate-types.js",
    "docs:dev": "vitepress dev docs",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:sync-check": "node scripts/generate-docs.js --compare",
    "docs:syntax": "node scripts/extract-syntax.js",
    "docs:llms": "node scripts/generate-llms-txt.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:packaging": "node --test \"tests/packaging/**/*.test.js\"",
    "test:sync": "node --test \"tests/sync/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:coverage": "npx c8 --exclude dist --reporter=text --reporter=html node --test \"tests/**/*.test.js\"",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:jit": "playwright test --config playwright.jit.config.js",
    "lint": "eslint src/",
    "lint:css": "stylelint \"public/**/*.css\" \"dist/**/*.css\"",
    "lint:css:fix": "stylelint \"public/**/*.css\" \"dist/**/*.css\" --fix",
    "lint:all": "npm run lint && npm run lint:css",
    "typecheck": "tsc -p tests/types/tsconfig.json",
    "golden": "node tests/golden/build-golden.mjs --check",
    "size": "size-limit"
  },
  "keywords": [
    "css",
    "framework",
    "utility-css",
    "natural-language",
    "intent-first",
    "vite-plugin",
    "postcss-plugin",
    "vite",
    "postcss"
  ],
  "homepage": "https://bookklik-technologies.github.io/senangstart-css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/senangstart-css.git"
  },
  "bugs": {
    "url": "https://github.com/bookklik-technologies/senangstart-css/issues"
  },
  "author": "a-hakim",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^11.1.0",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "postcss": ">=8.4.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^14.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "size-limit": "^14.1.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    }
  },
  "size-limit": [
    {
      "name": "CDN JIT runtime (min, gzip)",
      "path": "dist/senangstart-css.min.js",
      "limit": "40 KB",
      "gzip": true
    },
    {
      "name": "Standalone CSS (min, gzip)",
      "path": "dist/senangstart.min.css",
      "limit": "30 KB",
      "gzip": true
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
