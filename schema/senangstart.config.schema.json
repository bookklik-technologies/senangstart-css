        "fontWeight": {
          "type": "object",
          "description": "Font-weight scale used by font:.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "normal": "400",
            "medium": "500",
            "bold": "700"
          }
        },
        "screens": {
          "type": "object",
          "description": "Breakpoints used as variant prefixes (tab:, max-tab:, tab-lap:). Values are min-width lengths or \"print\".",
          "additionalProperties": {
            "type": "string"
