{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bookklik-technologies.github.io/senangstart-css/schema/senangstart.config.schema.json",
  "title": "SenangStart CSS configuration",
  "description": "Configuration for senangstart.config.{js,mjs,cjs,json}. Generated by scripts/generate-schema.js from src/config/defaults.js — do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference (JSON configs only), e.g. \"./node_modules/@bookklik/senangstart-css/schema/senangstart.config.schema.json\"."
    },
    "content": {
      "type": "array",
      "description": "Glob patterns to scan for layout/space/visual attributes, relative to the project root. Prefix with \"!\" to negate. node_modules, .git and dist are ignored by default.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "./**/*.html",
        "./**/*.{php,blade.php}",
        "./**/*.{js,jsx,ts,tsx}",
        "./**/*.{vue,svelte,astro}",
        "./**/*.{md,mdx}"
      ]
    },
    "safelist": {
      "type": "array",
      "description": "Tokens to always emit even when not found in content. Entries are raw tokens (\"p:medium\", \"visual=bg:primary\", \"flex\") or { attr, tokens } groups.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "attr",
              "tokens"
            ],
            "additionalProperties": false,
            "properties": {
              "attr": {
                "type": "string",
                "enum": [
                  "layout",
                  "space",
                  "visual",
                  "interact",
                  "listens"
                ]
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "default": []
    },
    "prefix": {
      "type": "string",
      "description": "Attribute prefix: \"ss\" makes the attributes ss-layout / ss-space / ss-visual (unprefixed attributes are then ignored). Empty string disables.",
      "default": ""
    },
    "layers": {
      "type": "boolean",
      "description": "Wrap emitted CSS in cascade layers (@layer senangstart.theme, senangstart.base, senangstart.utilities).",
      "default": true
    },
    "utilities": {
      "type": "object",
      "description": "Custom utilities. Key = utility name; value = { attr, css } for a keyword or { attr, template, scale, literals, enum, passthrough, numeric, arbitrary } for a valued utility. See docs/guide/plugins.md.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "attr": {
            "type": "string",
            "enum": [
              "layout",
              "space",
              "visual"
            ],
            "default": "visual"
          },
          "css": {
            "type": "string",
            "description": "Static declarations (keyword utility)."
          },
          "template": {
            "type": "string",
            "description": "Declaration template with {value}."
          },
          "arbitraryTemplate": {
            "type": "string"
          },
          "scale": {
            "type": "string",
            "description": "theme key whose entries are the accepted values."
          },
          "literals": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "enum": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "passthrough": {
            "type": "boolean"
          },
          "arbitrary": {
            "type": "boolean"
          },
          "numeric": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string"
              },
              "divide": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "description": "Custom variants. \"&:hover, &:focus\" (state, alternatives become :is()), \"[data-theme=dark] &\" (ancestor), or \"@media (…)\" / \"@supports (…)\".",
      "additionalProperties": {
        "type": "string"
      }
    },
    "plugins": {
      "type": "array",
      "description": "Functional plugins (JS configs only): ({ addUtilities, addVariants, addKeyframes, addAnimation, theme }) => void.",
      "items": {}
    },
    "output": {
      "type": "object",
      "description": "Output files.",
      "additionalProperties": false,
      "properties": {
        "css": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the generated stylesheet.",
          "default": "./public/senangstart.css"
        },
        "minify": {
          "type": "boolean",
          "description": "Minify the generated CSS.",
          "default": false
        },
        "aiContext": {
          "description": "Opt-in AI context file path (e.g. \"./.cursorrules\"). null or false disables.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ],
          "default": null
        },
        "typescript": {
          "description": "Opt-in project-local TypeScript definitions path (e.g. \"./types/senang.d.ts\"). The file augments React/Vue/Svelte/Solid/Preact/Astro with your theme. null or false disables; prefer importing \"@bookklik/senangstart-css/react\" (etc.) when you use the default theme.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ],
          "default": null
        }
      },
      "default": {
        "css": "./public/senangstart.css",
        "minify": false,
        "aiContext": null,
        "typescript": null
      }
    },
    "darkMode": {
      "description": "Dark-mode strategy: \"media\" (prefers-color-scheme), \"selector\" or \"class\" (.dark ancestor), [\"selector\", \".custom\"] for a custom ancestor selector, or false to disable dark: variants.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "media",
            "selector",
            "class"
          ]
        },
        {
          "type": "array",
          "items": [
            {
              "type": "string",
              "enum": [
                "selector"
              ]
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      ],
      "default": "media"
    },
    "preflight": {
      "type": "boolean",
      "description": "Include the opinionated base reset styles.",
      "default": true
    },
    "build": {
      "type": "object",
      "description": "Build behaviour.",
      "additionalProperties": false,
      "properties": {
        "ignoreInvalid": {
          "type": "boolean",
          "description": "Warn instead of failing (exit code 1) when invalid tokens are found. Same as --ignore-invalid.",
          "default": false
        }
      },
      "default": {
        "ignoreInvalid": false
      }
    },
    "ignoreInvalid": {
      "type": "boolean",
      "description": "Top-level alias of build.ignoreInvalid.",
      "default": false
    },
    "theme": {
      "type": "object",
      "description": "Theme customisation. Direct scale keys are deep-merged into the defaults; theme.extend is applied afterwards (Tailwind-style) and always wins.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "properties": {
        "spacing": {
          "type": "object",
          "description": "Spacing scale (\"Natural Object\" adjectives) used by p:, m:, g:, w:, h:, inset: … Values are CSS lengths.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "none": "0px",
            "thin": "1px",
            "regular": "2px",
            "thick": "3px",
            "tiny": "4px",
            "tiny-2x": "6px",
            "small": "8px",
            "small-2x": "10px",
            "small-3x": "12px",
            "small-4x": "14px",
            "medium": "16px",
            "medium-2x": "20px",
            "medium-3x": "24px",
            "medium-4x": "28px",
            "large": "32px",
            "large-2x": "36px",
            "large-3x": "40px",
            "large-4x": "44px",
            "big": "48px",
            "big-2x": "56px",
            "big-3x": "64px",
            "big-4x": "80px",
            "giant": "96px",
            "giant-2x": "112px",
            "giant-3x": "128px",
            "giant-4x": "144px",
            "vast": "160px",
            "vast-2x": "176px",
            "vast-3x": "192px",
            "vast-4x": "208px",
            "vast-5x": "224px",
            "vast-6x": "240px",
            "vast-7x": "256px",
            "vast-8x": "288px",
            "vast-9x": "320px",
            "vast-10x": "384px"
          }
        },
        "radius": {
          "type": "object",
          "description": "Border-radius scale used by rounded:.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "none": "0px",
            "small": "4px",
            "medium": "8px",
            "big": "16px",
            "round": "9999px"
          }
        },
        "shadow": {
          "type": "object",
          "description": "Box-shadow scale used by shadow:.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "none": "none",
            "small": "0 1px 2px rgba(0,0,0,0.05)",
            "medium": "0 4px 6px rgba(0,0,0,0.1)",
            "big": "0 10px 15px rgba(0,0,0,0.15)",
            "giant": "0 25px 50px rgba(0,0,0,0.25)"
          }
        },
        "fontSize": {
          "type": "object",
          "description": "Font-size scale used by text-size:.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "mini": "0.75rem",
            "small": "0.875rem",
            "base": "1rem",
            "large": "1.125rem",
            "big": "1.25rem",
            "huge": "1.5rem",
            "grand": "1.875rem",
            "giant": "2.25rem",
            "mount": "3rem",
            "mega": "3.75rem",
