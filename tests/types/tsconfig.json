      "@bookklik/senangstart-css/preact": ["../../types/preact.d.ts"],
      "@bookklik/senangstart-css/astro": ["../../types/astro.d.ts"],
      "react": ["./stubs/react.d.ts"],
      "react/jsx-runtime": ["./stubs/react-jsx-runtime.d.ts"],
